{
  "name": "pi-dedup-read",
  "version": "1.0.0",
  "description": "pi extension — deduplicate read tool: warns on re-read of unchanged files by content hash",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src/"
  ],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
