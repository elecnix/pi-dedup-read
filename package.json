    "lint": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-ai": "^0.82.1",
    "typebox": "^1.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
